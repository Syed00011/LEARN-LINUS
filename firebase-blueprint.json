{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "streak": { "type": "integer" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Progress": {
      "title": "Progress",
      "description": "User progress through lessons and quizzes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "status": { "type": "string", "enum": ["locked", "available", "completed"] },
        "score": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "lessonId"]
    },
    "Post": {
      "title": "Post",
      "description": "A forum post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "likes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a forum post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "content"]
    },
    "Book": {
      "title": "Book",
      "description": "A book in the library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "coverUrl": { "type": "string" },
        "isPremium": { "type": "boolean" }
      }
    },
    "ReadingGoal": {
      "title": "ReadingGoal",
      "description": "User's reading targets",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookId": { "type": "string" },
        "progress": { "type": "number" },
        "goalDate": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user information"
    },
    "/progress/{progressId}": {
      "schema": "Progress",
      "description": "User lesson progress"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Forum topics"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on topics"
    },
    "/library/{bookId}": {
      "schema": "Book",
      "description": "Linux library books"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "ReadingGoal",
      "description": "Personal reading schedules"
    }
  }
}
